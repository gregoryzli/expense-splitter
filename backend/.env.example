# MySQL connection string used by Prisma. Local dev/docker-compose uses the
# plain form below; a TiDB Serverless production DB needs an extra query
# param, e.g. mysql://user:pw@host:4000/db?sslaccept=strict
DATABASE_URL="mysql://root:devpassword@localhost:3306/expense_splitter_db"

# Signs and verifies auth JWTs -- use a long random value in real deployments
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=3001
NODE_ENV=development

# Origin the frontend is served from, for CORS + cookie SameSite behavior
CORS_ORIGIN="http://localhost:3000"

# Set to "true" only when the backend is actually served over HTTPS (real
# deployments, frontend on a different domain). Leave unset/false for any
# plain-HTTP setup (local dev, docker-compose) -- a secure cookie sent over
# HTTP is silently dropped by the browser, which breaks login in a
# confusing way (login returns 200, then every request 401s).
COOKIE_SECURE=false
