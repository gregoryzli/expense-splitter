# MySQL connection string used by Prisma
DATABASE_URL="mysql://root:devpassword@localhost:3306/expense_splitter_db"

# Signs and verifies auth JWTs -- use a long random value in real deployments
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=3001
NODE_ENV=development

# Origin the frontend is served from, for CORS + cookie SameSite behavior
CORS_ORIGIN="http://localhost:3000"
