generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  groupsCreated       Group[]        @relation("GroupCreator")
  memberships         GroupMember[]
  expensesPaid        Expense[]      @relation("ExpensePayer")
  expensesCreated     Expense[]      @relation("ExpenseCreator")
  splits              ExpenseSplit[]
  settlementsFrom     Settlement[]   @relation("SettlementFrom")
  settlementsTo       Settlement[]   @relation("SettlementTo")
  settlementsInitiated Settlement[]  @relation("SettlementInitiator")
  savedFriends        Friend[]       @relation("FriendOwner")
  friendedBy          Friend[]       @relation("FriendTarget")

  @@map("users")
}

// A one-directional saved-contacts list, not a mutual relationship: saving
// someone doesn't notify them or add you to their list. It just lets you
// skip re-searching for people you split expenses with regularly.
model Friend {
  userId    Int      @map("user_id")
  friendId  Int      @map("friend_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User @relation("FriendOwner", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendTarget", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([userId, friendId])
  @@index([friendId])
  @@map("friends")
}

model Group {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  // Display label only, agreed on by the group at creation time -- see
  // lib/money.ts. Nothing converts between currencies or verifies amounts
  // were actually entered in this unit; it just picks which symbol every
  // member sees for this group's numbers.
  currency    String   @default("USD") @db.VarChar(3)
  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy   User          @relation("GroupCreator", fields: [createdById], references: [id])
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]

  @@map("groups")
}

model GroupMember {
  groupId  Int      @map("group_id")
  userId   Int      @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
}

model Expense {
  id          Int       @id @default(autoincrement())
  groupId     Int       @map("group_id")
  paidById    Int       @map("paid_by")
  createdById Int       @map("created_by")
  amountCents Int       @map("amount_cents")
  description String    @db.VarChar(200)
  category    String    @db.VarChar(50)
  splitType   SplitType @default(EQUAL) @map("split_type")
  expenseDate DateTime  @map("expense_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy    User           @relation("ExpensePayer", fields: [paidById], references: [id])
  createdBy User           @relation("ExpenseCreator", fields: [createdById], references: [id])
  splits    ExpenseSplit[]

  @@index([groupId])
  @@map("expenses")
}

model ExpenseSplit {
  id         Int @id @default(autoincrement())
  expenseId  Int @map("expense_id")
  userId     Int @map("user_id")
  shareCents Int @map("share_cents")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("expense_splits")
}

enum SettlementStatus {
  PENDING
  CONFIRMED
}

model Settlement {
  id            Int              @id @default(autoincrement())
  groupId       Int              @map("group_id")
  fromUserId    Int              @map("from_user_id")
  toUserId      Int              @map("to_user_id")
  amountCents   Int              @map("amount_cents")
  status        SettlementStatus @default(PENDING)
  initiatedById Int              @map("initiated_by")
  settledAt     DateTime         @default(now()) @map("settled_at")
  confirmedAt   DateTime?        @map("confirmed_at")

  group       Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser    User  @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUser      User  @relation("SettlementTo", fields: [toUserId], references: [id])
  initiatedBy User  @relation("SettlementInitiator", fields: [initiatedById], references: [id])

  @@index([groupId])
  @@map("settlements")
}
